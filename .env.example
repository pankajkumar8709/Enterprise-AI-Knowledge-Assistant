# Enterprise AI Knowledge Assistant — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- required ---
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/enterprise_ai_ka
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# --- application ---
APP_NAME=Enterprise AI Knowledge Assistant API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- storage ---
DOCUMENT_UPLOAD_DIR=storage/documents
DOCUMENT_EXTRACTION_DIR=storage/extractions
MAX_DOCUMENT_SIZE_BYTES=10485760

# --- chunking (tokens, spec section 4) ---
CHUNK_TARGET_TOKENS=500
CHUNK_MAX_TOKENS=700
CHUNK_MIN_TOKENS=60
CHUNK_OVERLAP_TOKENS=80

# --- CORS (comma separated origins) ---
CORS_ORIGINS=http://localhost:5173
