# Copy this file to .env and set local values. Never commit .env.

# --- required ---
# These defaults work with `docker compose up -d` from the repository root.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/enterprise_ai_ka
# Must be at least 32 characters. Replace with a unique random value.
JWT_SECRET=replace-this-with-a-random-string-at-least-32-characters

# --- optional bootstrap administrator ---
# Set both values to create/update this managed admin account at backend startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- application ---
APP_NAME=Enterprise AI Knowledge Assistant API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_DAYS=7
ALLOW_SELF_SIGNUP=true
ALLOWED_EMAIL_DOMAINS=

# --- LLM (optional; disabled until explicitly enabled) ---
LLM_EXTERNAL_ALLOWED=false
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- storage and document processing ---
DOCUMENT_UPLOAD_DIR=storage/documents
DOCUMENT_EXTRACTION_DIR=storage/extractions
MAX_DOCUMENT_SIZE_BYTES=26214400
ALLOWED_EXTENSIONS=pdf,docx,pptx,txt,md,markdown
OCR_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=40
OCR_DPI=300
MIN_DOC_CHARS=200

# --- embeddings and chunking ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
CHUNK_TARGET_TOKENS=500
CHUNK_MAX_TOKENS=700
CHUNK_MIN_TOKENS=60
CHUNK_OVERLAP_TOKENS=80

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173
